<%- include("./partials/header") %>

<div class="game-detail">
  <div class="game-detail-cover">
    <% if (game.cover_image_url) { %>
      <img src="<%= game.cover_image_url %>" alt="Cover Image For <%= game.title %>"
        onerror="this.onerror=null;
        this.parentElement.innerHTML='<div class=\'game-card-placeholder\'>No Image</div>'" />
    <% } else { %>
      <div class="game-card-placeholder">No Image</div>
    <% } %>
  </div>

  <div class="game-detail-info">
    <h1><%= game.title %></h1>

    <% if (errors.length > 0) { %>
      <ul class="error-list">
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <div class="game-meta">
      <div class="game-meta-item">
        <span class="meta-label">Developer</span>
        <span><%= game.developer %></span>
      </div>

      <div class="game-meta-item">
        <span class="meta-label">Publisher</span>
        <span><%= game.publisher %></span>
      </div>

      <div class="game-meta-item">
        <span class="meta-label">Release Date</span>
        <span><%= game.release_date || 'TBA' %></span>
      </div>

      <div class="game-meta-item">
        <span class="meta-label">Price</span>
        <span class="price">$<%= game.price %></span>
      </div>

      <div class="game-meta-item">
        <span class="meta-label">Stock</span>
        <span><%= game.stock %> Units</span>
      </div>
    </div>

    <div class="game-tags">
      <% genres.forEach(genre => { %>
        <span class="tag tag-genre"><%= genre.name %></span>
      <% }) %>
      <% platforms.forEach(platform => { %>
        <span class="tag tag-platform"><%= platform.name %></span>
      <% }) %>
    </div>

    <% if (game.description) { %>
      <p class="game-description"><%= game.description %></p>
    <% } %>


    <div class="page-actions">
    <a href="/games/<%= game.id %>/edit" class="btn-link">Edit Game</a>
      <form method="POST" action="/games/<%= game.id %>/delete">
        <label for="adminPassword">Admin Password</label>
        <input type="password" id="adminPassword" name="adminPassword" required />
        <button type="submit" class="btn-delete">Delete Game</button>
      </form>
    </div>
  </div>
</div>

<%- include("./partials/footer") %>
