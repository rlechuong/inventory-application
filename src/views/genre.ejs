<%- include("./partials/header") %>

<h1><%= genre.name %> Games</h1>

<% if (errors.length > 0) { %>
  <ul>
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<a href="/games/new">Add Game</a>

<a href="/genres/<%= genre.id %>/edit">Edit Genre</a>

<form method="POST" action="/genres/<%= genre.id %>/delete">
  <label for="adminPassword">Admin Password</label>
  <input type="password" id="adminPassword" name="adminPassword" required />
  <button type="submit">Delete Genre</button>
</form>

<% if (games.length === 0) { %>
  <p>No games in this genre.</p>
<% } else { %>
  <ul>
    <% games.forEach(game => { %>
      <li><a href="/games/<%= game.id %>"><%= game.title %></a></li>
    <% }) %>
  </ul>
<% } %>

<%- include("./partials/footer") %>