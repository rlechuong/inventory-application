<%- include("./partials/header") %>

<h1><%= platform.name %> Games</h1>

<% if (errors.length > 0) { %>
  <ul class="error-list">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div class="page-actions">
  <a href="/games/new" class="btn-link">Add Game</a>
  <a href="/platforms/<%= platform.id %>/edit" class="btn-link">Edit Platform</a>
  <form method="POST" action="/platforms/<%= platform.id %>/delete">
    <label for="adminPassword">Admin Password</label>
    <input type="password" id="adminPassword" name="adminPassword" required />
    <button type="submit" class="btn-delete">Delete Platform</button>
  </form>
</div>

<% if (games.length === 0) { %>
  <p>No games in this platform.</p>
<% } else { %>
  <div class="card-grid">
    <% games.forEach(game => { %>
      <a href="/games/<%= game.id %>" class="game-card">
        <div class="game-card-image">
          <% if (game.cover_image_url) { %>
            <img src="<%= game.cover_image_url %>" alt="<%= game.title %>"
              onerror="this.onerror=null;
              this.parentElement.innerHTML='<div class=\'game-card-placeholder\'>No Image</div>'" />
          <% } else { %>
            <div class="game-card-placeholder">No Image</div>
          <% } %>
        </div>
        <div class="game-card-info">
          <h3><%= game.title %></h3>
          <p>$<%= game.price %></p>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include("./partials/footer") %>