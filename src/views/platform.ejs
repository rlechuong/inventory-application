<%- include("./partials/header") %>

<h1><%= platform.name %> Games</h1>

<% if (games.length === 0) { %>
  <p>No games in this platform.</p>
<% } else { %>
  <ul>
    <% games.forEach(game => { %>
      <li><%= game.title %></li>
    <% }) %>
  </ul>
<% } %>

<a href="/platforms/<%= platform.id %>/edit">Edit Platform</a>

<form method="POST" action="/platforms/<%= platform.id %>/delete">
  <button type="submit">Delete Platform</button>
</form>

<%- include("./partials/footer") %>