<%- include("./partials/header") %>

<h1>Genres</h1>

<a href="/genres/new">Add Genre</a>

<% if (genres.length === 0) { %>
  <p>No genres found.</p>
<% } else { %>
  <ul>
    <% genres.forEach(genre => { %>
      <li><a href="/genres/<%= genre.id %>"><%= genre.name %></a></li>
    <% }) %>
  </ul>
<% } %>

<%- include("./partials/footer") %>