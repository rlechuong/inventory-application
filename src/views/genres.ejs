<%- include("./partials/header") %>

<h1>Genres</h1>

<a href="/genres/new" class="btn-link">Add Genre</a>

<% if (genres.length === 0) { %>
  <p>No genres found.</p>
<% } else { %>
  <div class="category-grid">
    <% genres.forEach(genre => { %>
      <a href="/genres/<%= genre.id %>" class="category-card">
        <%= genre.name %>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include("./partials/footer") %>